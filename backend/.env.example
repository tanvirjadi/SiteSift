# OpenRouter API Key for SiteSift AI Multi-Agent Engine
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default LLM model to use on OpenRouter (e.g. google/gemini-2.5-flash, deepseek/deepseek-chat, anthropic/claude-3.5-sonnet, openai/gpt-4o-mini)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Backend server port
PORT=5000
